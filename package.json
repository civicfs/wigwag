{
  "name": "@civicfs/wigwag",
  "version": "0.3.5",
  "description": "Push messaging and a data channel between Claude Code and Codex sessions on one host",
  "license": "MIT",
  "author": {
    "name": "Michael Handelman"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/civicfs/wigwag.git"
  },
  "homepage": "https://github.com/civicfs/wigwag#readme",
  "bugs": {
    "url": "https://github.com/civicfs/wigwag/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "mcp",
    "agents",
    "messaging",
    "cli"
  ],
  "type": "module",
  "bin": {
    "wigwag": "dist/main.js",
    "ww": "dist/main.js"
  },
  "files": [
    "dist",
    "plugins",
    ".claude-plugin",
    ".agents",
    "install.sh",
    "README.md",
    "PRIVACY.md",
    "docs/provider-terms.md",
    "docs/spec.md",
    "docs/native-question-relay-2026-10-13.md",
    "docs/task-recovery-design.md",
    "docs/images",
    "docs/security-review-2026-10-13.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/public-release.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:upgrade": "vitest run tests/upgrade",
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && biome check . && npm run check:public -- --history && npm run check:package",
    "check:public": "node scripts/check-public.mjs",
    "lint:check": "biome check .",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ink": "8.0.0",
    "react": "19.3.0",
    "string-width": "8.3.0",
    "ulid": "3.0.2",
    "wrap-ansi": "10.0.2",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "@types/react": "19",
    "@types/ws": "8.18.2",
    "ink-testing-library": "4.0.0",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
